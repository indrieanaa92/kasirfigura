{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.3"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/(css|js|images|fonts)/(.*)",
            "dest": "/public/$1/$2"
        },
        {
            "src": "/(favicon\\.ico|robots\\.txt)",
            "dest": "/public/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_NAME": "Kasir Figura POS",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_LOCALE": "id",
        "APP_FALLBACK_LOCALE": "id",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "cookie",
        "CACHE_STORE": "array",
        "QUEUE_CONNECTION": "sync",
        "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
        "APP_SERVICES_CACHE": "/tmp/storage/bootstrap/services.php",
        "APP_PACKAGES_CACHE": "/tmp/storage/bootstrap/packages.php",
        "APP_CONFIG_CACHE": "/tmp/storage/bootstrap/config.php",
        "APP_ROUTES_CACHE": "/tmp/storage/bootstrap/routes.php",
        "APP_EVENTS_CACHE": "/tmp/storage/bootstrap/events.php",
        "DB_CONNECTION": "pgsql",
        "DB_SSLMODE": "require",
        "DB_EMULATE_PREPARES": "true"
    }
}

